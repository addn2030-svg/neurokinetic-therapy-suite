# ============================================================================
# NKT Suite + Personal AI Agent — Environment Variables TEMPLATE
# ⚠️  Copy to .env and fill real values. NEVER commit .env to Git.
# ⚠️  On Railway/Render put these in the dashboard "Variables / Env Vars".
# ============================================================================

# --- Supabase (Database + Auth + Storage) ---------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-public-with-RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-SERVER-ONLY-NEVER-FRONTEND
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-me-central-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-in-supabase-settings

# --- n8n (Automation engine — replaces engine/proactive.py) ----------------
N8N_ENCRYPTION_KEY=openssl-rand-hex-32-output-KEEP-FOREVER
N8N_WEBHOOK_URL=https://your-n8n-domain.com
N8N_API_KEY=n8n_api_xxxxxxxxxxxx
GENERIC_TIMEZONE=Asia/Riyadh
TZ=Asia/Riyadh

# --- Telegram Bot (Chief-of-Staff interface) --------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxx-from-BotFather
TELEGRAM_ALLOWED_CHAT_IDS=your-chat-id-only

# --- Google Workspace (Sheets + Drive for the task dashboard) ---------------
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
SHEET_TASKS_ID=1ZXmC_3_OTYYtXglNMXRQiSWu2rjDDIzoqaK0SQuWcWc

# --- Gemini (Chief-of-Staff persona / Gem) ----------------------------------
GEMINI_API_KEY=your-gemini-api-key-from-ai-studio

# --- Deployment platforms (optional, for CI automation) ----------------------
RAILWAY_TOKEN=railway-api-token
RENDER_API_KEY=rnd_xxxxxxxxxxxx
GITHUB_TOKEN=github_pat_fine_grained_contents_read

# --- Optional: daily brief email --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password
